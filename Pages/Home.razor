@page "/"
@inject IJSRuntime JS

<PageTitle>Diego Guimarães Advocacia | Direito Civil e Processo Civil</PageTitle>

<div class="site-shell @(menuOpen ? "menu-open" : "")">
  <header class="site-header">
    <a class="brand brand-image" href="#inicio" aria-label="Diego Guimarães Advocacia"><img src="images/logo-horizontal.png" alt="Diego Guimarães Advocacia" width="1330" height="350" /></a>
    <button class="menu-toggle" type="button" aria-label="@(menuOpen ? "Fechar menu" : "Abrir menu")" aria-expanded="@menuOpen" @onclick="ToggleMenu"><span></span><span></span></button>
    <nav class="primary-nav" aria-label="Navegação principal"><a href="#inicio" @onclick="CloseMenu">Início</a><a href="#sobre" @onclick="CloseMenu">Sobre</a><a href="#areas" @onclick="CloseMenu">Áreas de atuação</a><a href="#forma-trabalho" @onclick="CloseMenu">Forma de trabalho</a><a href="#conteudos" @onclick="CloseMenu">Conteúdos</a><a href="#contato" @onclick="CloseMenu">Contato</a><a class="header-cta" href="@WhatsAppUrl" target="_blank" rel="noopener">Agendar conversa <span aria-hidden="true">→</span></a></nav>
  </header>
  <main>
    <div id="inicio" class="hero-stage"><section class="hero" aria-labelledby="hero-title"><img class="hero-monogram" src="images/monograma-dg.png" alt="" aria-hidden="true" width="782" height="724" /><div class="hero-content"><span class="eyebrow"></span><h1 id="hero-title">Advocacia com clareza,<br />responsabilidade e <em>estratégia.</em></h1><p class="hero-description">Atuação em Direito Civil e Processo Civil, com análise cuidadosa dos fatos, dos documentos e das alternativas jurídicas aplicáveis a cada situação.</p><p class="hero-description">Atendimento presencial em Lauro de Freitas/BA e online em todo o Brasil.</p></div><aside class="hero-values" aria-label="Diferenciais"><p><b aria-hidden="true">⚖</b> Suporte<br />estratégico</p><p><b aria-hidden="true">◇</b> Atuação<br />ética</p><p><b aria-hidden="true">◌</b> Visão de<br />longo prazo</p><p><b aria-hidden="true">◇</b> Foco em<br />resultados</p></aside><a class="scroll-cue" href="#sobre"><span aria-hidden="true"></span>Role para descobrir</a></section>
    <section id="sobre" class="about section-pad" aria-labelledby="about-title"><div class="section-intro"><p class="kicker">Sobre</p><p class="section-number">01</p></div><div class="about-layout"><div class="about-heading"><p class="signature">Advogado • OAB/BA nº 76.043</p><h2 id="about-title">Diego Guimarães</h2><div class="about-specialty">Direito Civil · Processo Civil</div></div><div class="about-copy"><p>Diego Ramos Guimarães Silva Mesquita é advogado inscrito na Ordem dos Advogados do Brasil, Seção do Estado da Bahia, sob o nº 76.043, e cursa pós-graduação em Processo Civil na Escola Superior de Advocacia – ESA.</p><p>Sua atuação profissional concentra-se em Direito Civil e Processo Civil, especialmente na análise de processos, elaboração e revisão de documentos jurídicos, definição de estratégias processuais, tutelas provisórias, recursos, execuções e cumprimento de decisões judiciais.</p><p>Também atua em questões relacionadas a contratos, locações, relações imobiliárias e condominiais e Direito do Consumidor.</p><p>O trabalho é orientado pela análise criteriosa das informações e dos documentos apresentados, pela pesquisa da legislação e da jurisprudência aplicáveis e pela comunicação clara sobre as possibilidades, os riscos e os limites jurídicos de cada situação.</p><h3>Atuação profissional</h3><p>Diego Guimarães Advocacia representa a atuação profissional individual do advogado Diego Ramos Guimarães Silva Mesquita.</p><p>A atuação abrange serviços consultivos, preventivos, extrajudiciais e judiciais, com atendimento a pessoas físicas e jurídicas.</p><p>Cada situação é examinada individualmente para a compreensão dos fatos, verificação dos documentos disponíveis e delimitação do serviço jurídico necessário.</p><p>O atendimento pode ser realizado presencialmente em Lauro de Freitas/BA ou virtualmente para interessados de qualquer região do Brasil.</p></div></div></section></div>
    <section id="areas" class="areas section-pad" aria-labelledby="areas-title"><div class="section-intro"><p class="kicker">Áreas de atuação</p><p class="section-number">02</p></div><h2 id="areas-title">Orientação precisa para decisões importantes.</h2><div class="practice-list"><details><summary><span>01</span><div><h3>Direito Civil e Processo Civil</h3><p>Atuação em conflitos de natureza civil e em questões relacionadas ao desenvolvimento do processo judicial.</p></div><span class="expand" aria-hidden="true">+</span></summary><div class="practice-details"><p>Serviços</p><ul><li>Consultas e orientações jurídicas</li><li>Análise de processos em andamento</li><li>Elaboração e revisão de petições</li><li>Tutelas provisórias e medidas urgentes</li><li>Recursos</li><li>Execuções e cumprimentos de sentença</li><li>Cobranças e defesas relacionadas a obrigações civis</li><li>Negociações e soluções extrajudiciais</li><li>Análise de nulidades, riscos e alternativas processuais</li></ul></div></details><details><summary><span>02</span><div><h3>Direito Imobiliário e Condominial</h3><p>Atuação em questões relacionadas a imóveis, posse, propriedade, condomínios e obrigações imobiliárias.</p></div><span class="expand" aria-hidden="true">+</span></summary><div class="practice-details"><p>Serviços</p><ul><li>Análise de documentos imobiliários</li><li>Questões possessórias</li><li>Obrigações condominiais</li><li>Cobranças e defesas de taxas condominiais</li><li>Execuções envolvendo imóveis</li><li>Conflitos entre compradores, vendedores, incorporadoras e condomínios</li><li>Distratos imobiliários</li><li>Responsabilidades relacionadas à posse, propriedade e entrega do imóvel</li></ul></div></details><details><summary><span>03</span><div><h3>Direito Contratual e Locações</h3><p>Elaboração, revisão e análise de contratos civis, identificando obrigações, responsabilidades e riscos.</p></div><span class="expand" aria-hidden="true">+</span></summary><div class="practice-details"><p>Serviços</p><ul><li>Elaboração e revisão de contratos</li><li>Contratos de locação residencial</li><li>Garantias locatícias</li><li>Laudos de vistoria</li><li>Inventários de móveis e bens</li><li>Distratos</li><li>Cobranças contratuais</li><li>Descumprimento contratual</li><li>Negociações extrajudiciais</li></ul></div></details><details><summary><span>04</span><div><h3>Direito do Consumidor</h3><p>Orientação e atuação em conflitos decorrentes das relações de consumo.</p></div><span class="expand" aria-hidden="true">+</span></summary><div class="practice-details"><p>Temas</p><ul><li>Cobranças indevidas</li><li>Descumprimento de contratos</li><li>Defeitos em produtos ou serviços</li><li>Responsabilidade de fornecedores</li><li>Negativas indevidas</li><li>Restituição de valores</li><li>Reparação de danos</li><li>Soluções administrativas, extrajudiciais e judiciais</li></ul></div></details><details><summary><span>05</span><div><h3>Consultoria Jurídica e Análise Processual</h3><p>Serviço destinado a pessoas físicas ou jurídicas que precisam compreender determinada situação jurídica, documento ou processo.</p></div><span class="expand" aria-hidden="true">+</span></summary><div class="practice-details"><p>Pode abranger</p><ul><li>Estudo do histórico</li><li>Análise documental</li><li>Fase processual</li><li>Riscos e possíveis irregularidades</li><li>Medidas juridicamente disponíveis</li><li>Decisões judiciais</li><li>Reunião para apresentação das conclusões</li><li>Parecer ou relatório, quando contratado</li></ul><p class="practice-note">As conclusões dependem das circunstâncias, dos documentos apresentados e das normas aplicáveis a cada situação.</p></div></details></div></section>
    <section id="forma-trabalho" class="work section-pad" aria-labelledby="work-title"><div class="section-intro"><p class="kicker">Forma de trabalho</p><p class="section-number">03</p></div><h2 id="work-title">Um trabalho conduzido com atenção a cada etapa.</h2><ol class="work-flow"><li><span>01</span><div><h3>Compreensão da situação</h3><p>O atendimento começa com a apresentação dos fatos, das dúvidas e dos objetivos da pessoa interessada.</p></div></li><li><span>02</span><div><h3>Análise dos documentos</h3><p>São examinados contratos, processos, decisões, comunicações e demais documentos relevantes.</p></div></li><li><span>03</span><div><h3>Diagnóstico jurídico</h3><p>São identificadas as normas aplicáveis, situação processual, possibilidades existentes e principais riscos.</p></div></li><li><span>04</span><div><h3>Definição do serviço</h3><p>O objeto do trabalho, extensão, honorários e responsabilidades são formalizados por escrito.</p></div></li><li><span>05</span><div><h3>Atuação e acompanhamento</h3><p>Após a contratação, são adotadas as medidas definidas e prestadas informações relacionadas ao desenvolvimento do serviço.</p></div></li></ol><div class="work-principles"><div><p class="kicker">Princípios</p><h3>Uma atuação técnica, transparente e orientada ao contexto de cada caso.</h3></div><div class="principles-list"><article><h4>Clareza</h4><p>Informações jurídicas apresentadas de maneira compreensível.</p></article><article><h4>Responsabilidade</h4><p>Possibilidades e riscos avaliados antes da adoção das medidas.</p></article><article><h4>Coerência estratégica</h4><p>Cada medida relacionada aos fatos, provas disponíveis e objetivos juridicamente possíveis.</p></article><article><h4>Comunicação</h4><p>Informações necessárias para o cliente compreender o serviço e as decisões relacionadas ao caso.</p></article><article><h4>Aperfeiçoamento profissional</h4><p>Estudo contínuo da legislação, jurisprudência e mudanças relevantes para o exercício da advocacia.</p></article></div></div></section>
    <section id="conteudos" class="contents section-pad" aria-labelledby="contents-title"><div class="section-intro"><p class="kicker">Conteúdos jurídicos</p><p class="section-number">04</p></div><h2 id="contents-title">Análises e informações<br />para decisões mais conscientes.</h2><p class="contents-intro">Conteúdos sobre Direito Civil e Processo Civil, apresentados de forma clara e objetiva para auxiliar na compreensão de questões jurídicas do cotidiano.</p><div class="editorial-axes"><article><span>01</span><div><h3>Direito Civil</h3><p>Contratos · Locações · Relações imobiliárias · Condomínios · Direito do Consumidor</p></div><span class="editorial-arrow" aria-hidden="true">→</span></article><article><span>02</span><div><h3>Processo Civil</h3><p>Execução · Cumprimento de sentença · Tutelas · Recursos · Questões processuais</p></div><span class="editorial-arrow" aria-hidden="true">→</span></article><article><span>03</span><div><h3>Análises jurídicas</h3><p>Legislação · Decisões judiciais · Orientações informativas · Temas jurídicos relevantes</p></div><span class="editorial-arrow" aria-hidden="true">→</span></article></div><p class="contents-note">Os conteúdos possuem finalidade exclusivamente informativa e não substituem a análise individualizada de cada situação.</p></section>
    <section id="contato" class="contact section-pad" aria-labelledby="contact-title"><div class="contact-layout"><div class="contact-intro"><p class="kicker">Contato</p><h2 id="contact-title">Vamos conversar sobre<br />a sua situação?</h2><p>Envie as informações iniciais pelo formulário. Ao continuar, sua mensagem será preparada para envio pelo WhatsApp.</p><dl><div><dt>Atendimento presencial</dt><dd>Lauro de Freitas/BA</dd></div><div><dt>Atendimento online</dt><dd>Todo o Brasil</dd></div></dl><a class="contact-whatsapp" href="@WhatsAppUrl" target="_blank" rel="noopener">WhatsApp: (71) 99288-8757</a></div><form class="contact-form" @onsubmit="OpenWhatsApp" @onsubmit:preventDefault><label for="contact-name">Nome *</label><input id="contact-name" type="text" @bind="contactName" placeholder="Seu nome" autocomplete="name" maxlength="100" required /><label for="contact-phone">Telefone *</label><input id="contact-phone" type="tel" @bind="contactPhone" placeholder="(00) 00000-0000" autocomplete="tel" maxlength="20" required /><label for="contact-subject">Assunto *</label><input id="contact-subject" type="text" @bind="contactSubject" placeholder="Informe brevemente o assunto" maxlength="140" required /><label for="contact-message">Mensagem *</label><textarea id="contact-message" @bind="contactMessage" placeholder="Conte brevemente como podemos ajudar" maxlength="1500" required></textarea><button type="submit">Continuar no WhatsApp <span aria-hidden="true">→</span></button><div class="contact-form-notes"><p>Evite encaminhar documentos ou informações sensíveis neste primeiro contato.</p><p>O contato inicial não representa aceitação da causa nem constitui, isoladamente, relação entre advogado e cliente.</p></div></form></div></section>
    <footer class="site-footer"><div class="footer-main"><div class="footer-identity"><img src="images/logo-horizontal.png" alt="Diego Guimarães Advocacia" width="1330" height="350" /><p>OAB/BA nº 76.043</p></div><div><p class="footer-title">Contato</p><a href="@WhatsAppUrl" target="_blank" rel="noopener">(71) 99288-8757</a><a href="mailto:adv.diegoguimaraes@gmail.com">adv.diegoguimaraes@gmail.com</a><p>Lauro de Freitas/BA</p></div><div><p class="footer-title">Navegação</p><nav class="footer-nav" aria-label="Links institucionais"><a href="#sobre">Sobre</a><a href="#areas">Áreas de atuação</a><a href="#forma-trabalho">Forma de trabalho</a><a href="#conteudos">Conteúdos</a><a href="#contato">Contato</a></nav></div></div><p class="footer-disclaimer">Conteúdo de caráter exclusivamente informativo. Cada situação jurídica depende da análise individual dos fatos, dos documentos e da legislação aplicável.</p><div class="footer-legal"><p>© 2026 Diego Guimarães Advocacia. Todos os direitos reservados. · Desenvolvido por <a href="https://ankhdigitalstudio.com/" target="_blank" rel="noopener noreferrer">Ankh Digital ☥ ↗</a></p><span>Aviso de Privacidade</span><span>Política de Cookies</span></div></footer>
  </main>
</div>

@code {
  private bool menuOpen;
  private const string WhatsAppUrl = "https://wa.me/5571992888757";
  private string contactName = string.Empty;
  private string contactPhone = string.Empty;
  private string contactSubject = string.Empty;
  private string contactMessage = string.Empty;

  private async Task OpenWhatsApp()
  {
    var name = contactName.Trim();
    var phone = contactPhone.Trim();
    var subject = contactSubject.Trim();
    var message = contactMessage.Trim();
    var text = $"Olá, gostaria de solicitar informações sobre atendimento.\n\nNome: {name}\nTelefone: {phone}\nAssunto: {subject}\n\nMensagem:\n{message}";
    await JS.InvokeVoidAsync("open", $"{WhatsAppUrl}?text={Uri.EscapeDataString(text)}", "_blank", "noopener");
  }
  private void ToggleMenu() => menuOpen = !menuOpen;
  private void CloseMenu() => menuOpen = false;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await JS.InvokeVoidAsync("microInteractions.init");
    }
  }
}

